# Netlify settings (this file is read by Netlify, ignored everywhere else)
# https://docs.netlify.com/routing/headers/

# Basic security headers for every page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fonts never change: browsers may keep them for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photos and icons: keep for a week (so replaced photos still update)
/images/*
  Cache-Control: public, max-age=604800

# Product videos
/videos/*
  Cache-Control: public, max-age=604800

# The docs folder is for you, not for visitors or Google
/docs/*
  X-Robots-Tag: noindex
